{
  "openapi": "3.0.0",
  "info": {
    "title": "SOA Lab 3 - Product Management Service",
    "version": "1.0.0",
    "description": "Dịch vụ quản lý sản phẩm độc lập tuân thủ kiến trúc SOA, chạy cổng 3001, CSDL riêng SQLite và xác thực liên dịch vụ với Auth Service (Lab 2)."
  },
  "servers": [
    {
      "url": "http://localhost:3001",
      "description": "Product Service Local Server (Port 3001)"
    }
  ],
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Nhập JWT Token lấy từ Auth Service Lab 2 (POST http://localhost:3000/login)"
      }
    },
    "schemas": {
      "Product": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "example": 1 },
          "name": { "type": "string", "example": "Laptop Dell XPS 15" },
          "description": { "type": "string", "example": "Laptop cao cấp mỏng nhẹ, CPU Intel Core i7" },
          "price": { "type": "number", "format": "float", "example": 35000000 },
          "quantity": { "type": "integer", "example": 10 },
          "created_at": { "type": "string", "example": "2026-10-18 08:00:00" },
          "updated_at": { "type": "string", "example": "2026-10-18 08:00:00" }
        }
      },
      "CreateProductInput": {
        "type": "object",
        "required": ["name", "price"],
        "properties": {
          "name": { "type": "string", "example": "Bàn phím cơ Aula F75" },
          "description": { "type": "string", "example": "Bàn phím cơ không dây 3 chế độ kết nối, mạch xuôi" },
          "price": { "type": "number", "example": 1250000 },
          "quantity": { "type": "integer", "example": 20 }
        }
      },
      "UpdateProductInput": {
        "type": "object",
        "properties": {
          "name": { "type": "string", "example": "Bàn phím cơ Aula F75 Pro" },
          "description": { "type": "string", "example": "Phiên bản nâng cấp pin 4000mAh" },
          "price": { "type": "number", "example": 1350000 },
          "quantity": { "type": "integer", "example": 15 }
        }
      }
    }
  },
  "paths": {
    "/products": {
      "get": {
        "summary": "Lấy danh sách tất cả các sản phẩm",
        "tags": ["Products"],
        "responses": {
          "200": { "description": "Lấy danh sách thành công" }
        }
      },
      "post": {
        "summary": "Thêm một sản phẩm mới (Cần Token)",
        "tags": ["Products"],
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CreateProductInput" }
            }
          }
        },
        "responses": {
          "201": { "description": "Thêm sản phẩm thành công" },
          "400": { "description": "Dữ liệu không hợp lệ" },
          "401": { "description": "Chưa xác thực token" }
        }
      }
    },
    "/products/{id}": {
      "get": {
        "summary": "Lấy thông tin chi tiết một sản phẩm",
        "tags": ["Products"],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": { "description": "Lấy chi tiết thành công" },
          "404": { "description": "Không tìm thấy sản phẩm" }
        }
      },
      "put": {
        "summary": "Cập nhật thông tin sản phẩm (Cần Token)",
        "tags": ["Products"],
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/UpdateProductInput" }
            }
          }
        },
        "responses": {
          "200": { "description": "Cập nhật thành công" },
          "401": { "description": "Chưa xác thực token" },
          "404": { "description": "Không tìm thấy sản phẩm" }
        }
      },
      "delete": {
        "summary": "Xóa một sản phẩm (Cần Token)",
        "tags": ["Products"],
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": { "description": "Xóa thành công" },
          "401": { "description": "Chưa xác thực token" },
          "404": { "description": "Không tìm thấy sản phẩm" }
        }
      }
    }
  }
}
